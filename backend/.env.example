# FastAPI
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Google Drive OAuth - create OAuth 2.0 Web application credentials in Google Cloud
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google-drive/callback
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_TOKEN_FILE=backend/data/google_token.json

# Qdrant: local persistent mode is used when QDRANT_URL is empty.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_knowledge
QDRANT_LOCAL_PATH=backend/data/qdrant

# Embedding model (384 dimensions for all-MiniLM-L6-v2)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional Groq generation. Retrieval can be tested without this key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
