```gitignore
# Python virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]

# Environment variables and secrets
.env
.env.*
!.env.example

# Google authentication tokens
data/google_token.json
data/*token*.json

# Qdrant database
data/qdrant/

# Uploaded documents
data/documents/*
!data/documents/.gitkeep
```